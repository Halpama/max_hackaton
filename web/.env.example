# API
# Leave empty in local dev: the app talks to the same origin and Vite proxies
# /api → http://127.0.0.1:8000. That way an iPhone on the same Wi‑Fi can open
# http://<your-mac-lan-ip>:5173 without hardcoding an IP here.
# For a direct backend URL (Docker web image, prod): http://localhost:8000
VITE_API_BASE_URL=

# Work against the bundled mock trip instead of the backend.
VITE_USE_MOCKS=false
