# ---- App ----
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=https://2-rist.ru,http://localhost:5173,http://localhost:4173,http://localhost:3000

# dev  -> initData signature is NOT verified, every request maps to DEV_USER_ID
# max  -> real MAX initData verification (enable once the bot is wired)
AUTH_MODE=dev
DEV_USER_ID=1

# ---- Postgres ----
POSTGRES_USER=trip
POSTGRES_PASSWORD=trip
POSTGRES_DB=trip
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- GigaChat ----
# Authorization key from the GigaChat personal cabinet: base64(client_id:client_secret)
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
# The Russian Trusted Root CA ships inside the image. Flip to false only if TLS breaks.
GIGACHAT_VERIFY_SSL=true

# ---- SearXNG (GigaChat web_search tool) ----
# Docker Compose service name by default. For host-run API use http://localhost:8081
SEARXNG_URL=http://searxng:8080

# ---- OpenTripMap ----
OPENTRIPMAP_API_KEY=
OPENTRIPMAP_LANG=ru
OPENTRIPMAP_DAILY_LIMIT=1000
# Seconds between requests. The free tier answers 429 to bursts.
OPENTRIPMAP_MIN_INTERVAL=0.12

# ---- openrouteservice (routing) ----
# Free tier: 2000 directions/day, 40/min. Falls back to public OSRM when empty.
ORS_API_KEY=
ORS_MIN_INTERVAL=1.6

# ---- Enrichment (free, keyless) ----
# KudaGo: opening hours, real popularity and edited Russian copy for 12 cities.
KUDAGO_ENABLED=true
# Open-Meteo: per-day forecast, omitted beyond the 16-day horizon.
WEATHER_ENABLED=true

# ---- MAX bot ----
# Token from https://business.max.ru (Authorization header value, not ?access_token=).
MAX_BOT_ENABLED=false
MAX_BOT_TOKEN=
# auto — webhook if MAX_BOT_WEBHOOK_URL is set, otherwise long polling.
# webhook | polling | off
MAX_BOT_MODE=auto
# Public HTTPS URL of POST /api/v1/bot/webhook (ngrok / cloudflare tunnel / prod).
# Leave empty for local demo — the API will long-poll platform-api2.max.ru.
MAX_BOT_WEBHOOK_URL=
# Optional shared secret; MAX sends it as X-Max-Bot-Api-Secret.
MAX_BOT_WEBHOOK_SECRET=
# Mini-app SPA URL (browser fallback link). The in-MAX open_app button uses the
# bot username / contact_id from GET /me — bind the SPA URL in the MAX cabinet
# under Расширенные настройки → ссылка мини-приложения.
MAX_WEBAPP_URL=https://2-rist.ru
